---
import SiteLayout from "../../layout/SiteLayout.astro";
import TreatmentsContent from "../../components/TreatmentsContent.astro";
import { useTranslations } from "../../i18n/utils";
import { ui } from "../../i18n/ui";

export async function getStaticPaths() {
  return ["en", "de", "fr", "es", "ca"].map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as keyof typeof ui;
const t = useTranslations(lang);
---

<SiteLayout
  lang={lang}
  page="treatments"
  title={t("treatments.seo.title")}
  description={t("treatments.seo.description")}
  canonical={`https://esteticaderma.com/${lang === "es" ? "" : `${lang}/`}tratamientos/`}
>
  <TreatmentsContent lang={lang} />
</SiteLayout>
