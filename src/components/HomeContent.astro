---
import { CarouselWrapper } from "./ui/CarouselWrapper";
import TitlePage from "./TitlePage.astro";
import MapWrapper from "./MapWrapper.astro";
import Gallery from "./Gallery.astro";
import FeaturedTreatments from "./FeaturedTreatments.astro";
import Brands from "./Brands.astro";
import Reviews from "./Reviews.astro";
import ImagePlaceholder from "./ImagePlaceholder.astro";
import { localizedPath, useTranslations } from "../i18n/utils";
import { ui } from "../i18n/ui";

interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const whatsapp = (message: string) =>
  `https://wa.me/34691310652?text=${encodeURIComponent(message)}`;

const heroImages = [
  {
    path: "/images/Limpieza-facial-profunda.jpg",
    alt: t("images.hero.facial"),
    width: 1920,
    height: 1080,
  },
  {
    path: "/images/beauty-face-massage-56884.jpg",
    alt: t("images.hero.massage"),
    width: 3888,
    height: 2592,
  },
  {
    path: "/images/7eb0dcf310238450490b27502631cb48.jpg",
    alt: t("images.hero.chocolate"),
    width: 3500,
    height: 2102,
  },
];

const galleryImages = [
  {
    path: "/images/Limpieza-facial-profunda-resized.jpg",
    alt: t("images.gallery.facial"),
    width: 1024,
    height: 492,
  },
  {
    path: "/images/beauty-face-massage-56884-resized.jpg",
    alt: t("images.gallery.massage"),
    width: 1024,
    height: 492,
  },
  {
    path: "/images/7eb0dcf310238450490b27502631cb48-resized.jpg",
    alt: t("images.gallery.chocolate"),
    width: 1024,
    height: 492,
  },
  {
    path: "/images/medicina-estetica-mujer-1024x492-resized.jpg",
    alt: t("images.gallery.treatment"),
    width: 1024,
    height: 492,
  },
];

// Treatments without `image` render a placeholder; add `price: "45 €"` to show a price.
const featuredTreatments = [
  {
    name: t("services.facial.1"),
    category: t("services.facial.title"),
    image: "/images/Limpieza-facial-profunda-resized.jpg",
  },
  {
    name: t("services.spa.6"),
    category: t("services.spa.title"),
    image: "/images/7eb0dcf310238450490b27502631cb48-resized.jpg",
  },
  {
    name: t("services.facial.6"),
    category: t("services.facial.title"),
    image: "/images/beauty-face-massage-56884-resized.jpg",
  },
  {
    name: t("services.facial.7"),
    category: t("services.facial.title"),
    image: "/images/medicina-estetica-mujer-1024x492-resized.jpg",
  },
  {
    name: t("services.body.7"),
    category: t("services.body.title"),
  },
  {
    name: t("services.body.2"),
    category: t("services.body.title"),
  },
  {
    name: t("services.spa.13"),
    category: t("services.spa.title"),
  },
];

const brands = [
  { name: "Ballancer", src: "/images/brands/ballancer.png", width: 174, height: 44 },
  { name: "Gerard's Nyxpert", src: "/images/brands/nyxpert.png", width: 90, height: 64 },
  { name: "System Roll Action", src: "/images/brands/rollaction.png", width: 169, height: 46 },
  { name: "Lucanni", src: "/images/brands/lucanni.png", width: 208, height: 37 },
  { name: "Thuya", src: "/images/brands/thuya.png", width: 113, height: 64 },
];
---

<section id="home" class="relative h-[80svh] min-h-[540px] lg:h-[85vh] overflow-hidden">
  <div class="absolute inset-0 z-0">
    <CarouselWrapper
      images={heroImages}
      className="h-[80svh] min-h-[540px] lg:h-[85vh]"
      priority={true}
      autoplay={true}
      client:load
    />
    <div class="absolute inset-0 bg-gradient-to-t from-brand-dark/80 via-brand-dark/35 to-brand-dark/10 pointer-events-none"></div>
  </div>

  <div class="relative z-10 h-full mx-auto max-w-7xl px-6 lg:px-10 flex items-end pb-16 md:pb-24 pointer-events-none">
    <div class="max-w-2xl pointer-events-auto">
      <p
        class="font-body text-xs font-medium uppercase tracking-[0.3em] text-warm-white/80 animate-fade-up"
        style="animation-delay: 0.1s; opacity: 0;"
      >
        {t("home.eyebrow")}
      </p>
      <h1
        class="font-display text-4xl md:text-6xl lg:text-7xl font-normal text-warm-white mt-5 leading-[1.05] animate-fade-up text-balance"
        style="animation-delay: 0.25s; opacity: 0;"
      >
        {t("home.h1")}
      </h1>
      <p
        class="font-display italic text-xl md:text-2xl text-warm-white/90 mt-5 animate-fade-up"
        style="animation-delay: 0.4s; opacity: 0;"
      >
        {t("home.p3")}
      </p>
      <div
        class="mt-10 flex flex-col sm:flex-row gap-3 animate-fade-up"
        style="animation-delay: 0.55s; opacity: 0;"
      >
        <a
          href={whatsapp(t("booking.whatsapp"))}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-light"
        >
          {t("home.cta")}
        </a>
        <a href={localizedPath(lang, "tratamientos/")} class="btn-outline-light">{t("home.cta_secondary")}</a>
      </div>
    </div>
  </div>
</section>

<section id="sobre-nosotros" class="py-20 md:py-28 lg:py-32 bg-warm-white">
  <div class="mx-auto max-w-7xl px-6 lg:px-10 grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
    <div class="overflow-hidden">
      <img
        src="/images/estetica-facial-barcelona-maxilodexeus.jpg"
        alt={t("images.gallery.treatment")}
        width="600"
        height="400"
        class="w-full aspect-[4/3] lg:aspect-[4/5] object-cover"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div>
      <TitlePage eyebrow={t("intro.eyebrow")} title={t("intro.title")} align="left" />
      <p class="font-body text-base md:text-lg text-brand-muted leading-relaxed mt-8">{t("home.p1")}</p>
      <p class="font-body text-base md:text-lg text-brand-muted leading-relaxed mt-4">{t("home.p2")}</p>
      <a
        href={whatsapp(t("booking.whatsapp"))}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-dark mt-10"
      >
        {t("home.cta")}
      </a>
    </div>
  </div>
</section>

<FeaturedTreatments
  eyebrow={t("featured.eyebrow")}
  title={t("featured.title")}
  treatments={featuredTreatments}
  priceOnRequest={t("featured.price_on_request")}
  bookLabel={t("featured.book")}
  bookingMessage={t("booking.whatsapp")}
  placeholderLabel={t("placeholder.image")}
  prevLabel={t("featured.prev")}
  nextLabel={t("featured.next")}
  viewAllLabel={t("featured.view_all")}
  viewAllHref={localizedPath(lang, "tratamientos/")}
/>

<Brands title={t("brands.eyebrow")} brands={brands} />

<Reviews eyebrow={t("reviews.eyebrow")} title={t("reviews.title")} ctaLabel={t("reviews.cta")} />

<section id="regalo" class="bg-brand-dark">
  <div class="grid grid-cols-1 lg:grid-cols-2">
    <ImagePlaceholder label={t("placeholder.image")} class="aspect-[4/3] lg:aspect-auto lg:min-h-[560px]" />
    <div class="px-6 py-20 md:px-16 lg:px-20 lg:py-28 flex flex-col justify-center max-w-2xl">
      <TitlePage eyebrow={t("gift.eyebrow")} title={t("gift.title")} align="left" light />
      <p class="font-body text-base md:text-lg text-warm-white/75 leading-relaxed mt-8">
        {t("popup.bono")}
      </p>
      <div class="mt-10">
        <a
          href={whatsapp(t("gift.whatsapp"))}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-light"
        >
          {t("gift.cta")}
        </a>
      </div>
    </div>
  </div>
</section>

<section id="galeria" class="py-20 md:py-28 lg:py-32 bg-warm-white">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <TitlePage eyebrow={t("gallery.subtitle")} title={t("gallery.title")} />
    <div class="mt-12 lg:mt-16">
      <Gallery images={galleryImages} />
    </div>
  </div>
</section>

<section id="ubicacion" class="py-20 md:py-28 lg:py-32 bg-cream">
  <div class="mx-auto max-w-7xl px-6 lg:px-10 grid grid-cols-1 lg:grid-cols-[2fr_3fr] gap-12 lg:gap-16 items-center">
    <div>
      <TitlePage eyebrow={t("ubication.title")} title={t("ubication.heading")} align="left" />
      <dl class="mt-10 space-y-8">
        <div>
          <dt class="eyebrow mb-3">{t("about.us.title")}</dt>
          <dd class="font-body text-base text-brand-muted leading-relaxed">
            {t("about.us.p1")}, {t("about.us.p2")}
          </dd>
        </div>
        <div>
          <dt class="eyebrow mb-3">{t("about.horary.title")}</dt>
          <dd class="font-body text-base text-brand-muted">{t("about.horary.p1")}</dd>
          <dd class="font-body text-base text-brand-muted">{t("about.horary.p2")}</dd>
        </div>
        <div>
          <dt class="eyebrow mb-3">{t("about.contact.title")}</dt>
          <dd class="font-body text-base text-brand-muted">{t("about.contact.p1")}</dd>
          <dd class="font-body text-base text-brand-muted">
            <a href="mailto:contacto@esteticaderma.com" class="hover:text-primary transition-colors">
              {t("about.contact.p2")}
            </a>
          </dd>
          <dd class="font-body text-base text-brand-muted">{t("about.contact.p3")}</dd>
        </div>
      </dl>
    </div>
    <div class="relative z-0 isolate overflow-hidden shadow-lg">
      <a
        href="https://maps.app.goo.gl/tpbQ5mXdgCtMiAWz7"
        class="block"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Ver ubicación en Google Maps"
      >
        <MapWrapper />
      </a>
    </div>
  </div>
</section>

