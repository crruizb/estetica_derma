---
import SocialLinks from "./SocialLinks.astro";

interface Props {
  subtitle: string;
  address: string;
  contact: string;
  company: string;
  services: string;
  servicesHref: string;
  cookiesPolicy: string;
  privacyPolicy: string;
  legalPolicy: string;
  horaryTitle: string;
  horary: string[];
  followLabel: string;
}

const {
  subtitle,
  address,
  contact,
  company,
  services,
  servicesHref,
  cookiesPolicy,
  privacyPolicy,
  legalPolicy,
  horaryTitle,
  horary,
  followLabel,
} = Astro.props;

const headingClass = "font-body text-xs font-medium uppercase tracking-[0.25em] text-secondary mb-5";
const linkClass = "font-body text-sm text-warm-white/70 hover:text-warm-white transition-colors";
---

<footer class="bg-brand-dark text-warm-white/70 w-full">
  <div class="mx-auto max-w-7xl px-6 lg:px-10 py-16 lg:py-20">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-16">
      <div>
        <img
          src="/images/Derma_logo.svg"
          alt="Derma"
          class="h-10 w-auto brightness-0 invert"
          loading="lazy"
          decoding="async"
        />
        <p class="font-body text-sm mt-5 max-w-xs leading-relaxed">{subtitle}</p>
        <p class={`${headingClass} mt-8`}>{followLabel}</p>
        <SocialLinks class="text-warm-white" iconClass="w-5 h-5" />
      </div>

      <div>
        <h3 class={headingClass}>{contact}</h3>
        <address class="not-italic space-y-2">
          <p class="font-body text-sm">{address}</p>
          <p class="font-body text-sm">08906 L'Hospitalet de Llobregat</p>
          <p>
            <a href="mailto:contacto@esteticaderma.com" class={linkClass}>contacto@esteticaderma.com</a>
          </p>
          <p class="font-body text-sm">
            <a href="tel:+34934385970" class={linkClass}>934 385 970</a>
            <span class="mx-1">–</span>
            <a href="tel:+34691310652" class={linkClass}>691 310 652</a>
          </p>
        </address>
      </div>

      <div>
        <h3 class={headingClass}>{horaryTitle}</h3>
        <ul class="space-y-2">
          {horary.map((line) => <li class="font-body text-sm">{line}</li>)}
        </ul>
      </div>

      <div>
        <h3 class={headingClass}>{company}</h3>
        <ul class="space-y-2">
          <li><a href={servicesHref} class={linkClass}>{services}</a></li>
          <li><a href="/politica-cookies/" class={linkClass}>{cookiesPolicy}</a></li>
          <li><a href="/politica-privacidad/" class={linkClass}>{privacyPolicy}</a></li>
          <li><a href="/aviso-legal/" class={linkClass}>{legalPolicy}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-warm-white/10 text-center">
      <p class="font-body text-xs">
        Copyright © {new Date().getFullYear()} Derma. All rights reserved.
      </p>
    </div>
  </div>
</footer>
