---
interface Props {
  eyebrow: string;
  title: string;
  align?: "center" | "left";
  light?: boolean;
}

const { eyebrow, title, align = "center", light = false } = Astro.props;
---

<div class:list={["flex flex-col", align === "center" ? "items-center text-center" : "items-start text-left"]}>
  <span class="eyebrow">{eyebrow}</span>
  <h2
    class:list={[
      "font-display text-4xl md:text-5xl lg:text-6xl font-normal mt-4 text-balance",
      light ? "text-warm-white" : "text-brand-dark",
    ]}
  >
    {title}
  </h2>
</div>
