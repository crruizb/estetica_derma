---
interface Image {
  path: string;
  alt: string;
  width: number;
  height: number;
}

interface Props {
  images: Image[];
}

const { images } = Astro.props;
---

<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 lg:gap-4">
  {
    images.map((image, i) => (
      <div class:list={["group overflow-hidden", i % 2 === 1 && "lg:mt-12"]}>
        <img
          class="w-full aspect-[3/4] object-cover transition-transform duration-700 group-hover:scale-105"
          src={image.path}
          alt={image.alt}
          width={image.width}
          height={image.height}
          loading="lazy"
          decoding="async"
        />
      </div>
    ))
  }
</div>
