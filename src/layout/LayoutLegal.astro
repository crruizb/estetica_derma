---
import SiteLayout from "./SiteLayout.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
---

<SiteLayout
  lang="es"
  page="legal"
  title={title}
  description={description}
  canonical={canonical}
  showCookies={false}
>
  <slot />
</SiteLayout>
